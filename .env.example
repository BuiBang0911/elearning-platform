# =============================================================
# .env.example — Copy to .env and fill in real values
# =============================================================

# ── Azure Container Registry ──
ACR_LOGIN_SERVER=edumindacr.azurecr.io
IMAGE_TAG=latest

# ── Azure Database for PostgreSQL ──
DB_CONNECTION_STRING=Server=YOUR_AZURE_PG_HOST.postgres.database.azure.com;Port=5432;Database=elearning-platform_db;User Id=YOUR_USER;Password=YOUR_PASSWORD;SslMode=Require;
RAG_DATABASE_URL=postgresql+psycopg2://YOUR_USER:YOUR_PASSWORD@YOUR_AZURE_PG_HOST.postgres.database.azure.com:5432/elearning-platform_db?sslmode=require

# ── Azure Cache for Redis ──
REDIS_CONNECTION_STRING=YOUR_REDIS.redis.cache.windows.net:6380,password=YOUR_REDIS_KEY,ssl=True,abortConnect=false

# ── JWT ──
JWT_KEY=YOUR_JWT_SECRET_KEY_AT_LEAST_64_CHARACTERS_LONG
JWT_ISSUER=EduMind
JWT_AUDIENCE=Edumind
JWT_EXPIRE_MINUTES=15

# ── Azure Storage ──
AZURE_STORAGE_CONNECTION=DefaultEndpointsProtocol=https;AccountName=edumindstoragebncb;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_CONTAINER_NAME=uploads
AZURE_STORAGE_BASE_URL=https://edumindstoragebncb.blob.core.windows.net

# ── Google AI (RAG Service) ──
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_API_KEYS_CHAT=KEY1,KEY2,KEY3
GOOGLE_API_KEYS_EMBEDDING=KEY4,KEY5,KEY6

# ── Celery / Redis for RAG ──
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Frontend ──
VITE_API_BASE_URL=https://edumind-api.azurewebsites.net/api
ALLOWED_ORIGINS=https://edumind.azurewebsites.net

# ── Local Dev (docker-compose.override.yml) ──
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=elearning-platform_db
